BASE_MODEL_NAME=google/gemma-4-E2B-it
DATASET_DIR=gsm8k_formatted
CHECKPOINT_DIR=checkpoints
FINAL_ADAPTER_DIR=gemma4-gsm8k-final

# Keep real secrets in your shell environment or a local .env file.
HUGGINGFACE_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supervisor defaults.
# Providers: llamacpp (GGUF via llama-server -- primary, free, offline)
#            | local (transformers on GPU) | self | exact | none
#            | gemini (free tier, small reference arm) | openai | anthropic (paid)
SUPERVISOR_PROVIDER=llamacpp

# Primary supervisor. Start it with scripts/serve_verifier.ps1 -Model glm.
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=GLM-4.7-Flash-UD-Q4_K_XL

# Pinned to 2.5: it is the newest Gemini Flash that accepts thinkingBudget=0.
# On 3.x, thinking cannot be disabled, its tokens are billed against the output
# budget, and the reply comes back empty -- which reads as approval.
GEMINI_SUPERVISOR_MODEL=gemini-2.5-flash
LOCAL_SUPERVISOR_MODEL=Qwen/Qwen3.5-9B
OPENAI_SUPERVISOR_MODEL=gpt-5.2
ANTHROPIC_SUPERVISOR_MODEL=claude-sonnet-4-5
SUPERVISOR_EVAL_SIZE=200
SUPERVISOR_MAX_OUTPUT_TOKENS=200
SUPERVISOR_MAX_RETRIES=5
SUPERVISOR_BACKOFF_SECONDS=2.0
SUPERVISOR_TIMEOUT=60
# Consecutive failures before a run stops. Supervisor errors become accepts, so
# an unbounded streak would approve every remaining question silently.
SUPERVISOR_ERROR_ABORT=10
# Client-side request pacing. 0 = unlimited (local). Use 10 on the Gemini free tier.
SUPERVISOR_RPM=0
RETRY_LIMIT=2

# FYDP 3 cascade
ATTEMPT1_CACHE=outputs/predictions/02_answers_finetuned_try1_main.jsonl
VERDICT_CACHE=outputs/verdict_cache.jsonl
SAMPLE_BANK_K=2
GATE_KIND=disagreement
ESCALATION_RATE=0.3
FEEDBACK_LEVEL=1
RETRY_TEMPERATURE=0.7

# Training defaults for RTX 4080 SUPER
MAX_SEQ_LENGTH=1024
MAX_NEW_TOKENS=512
TRAIN_EPOCHS=3
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=16
LEARNING_RATE=0.0002
WARMUP_STEPS=50
SAVE_STEPS=200
SAVE_TOTAL_LIMIT=2

